# Port the API/server listens on
PORT=5174

# Turso (libSQL) database connection. Leave unset for local development — the app then
# uses a local embedded file at ./data/grocery.db, no account or network needed.
#
# For production (Render), create a Turso database and paste its values here:
#   TURSO_DATABASE_URL=libsql://<your-db>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<token from the Turso dashboard or `turso db tokens create`>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Set to "production" to serve the built client from dist/client and mark session
# cookies secure (HTTPS-only).
NODE_ENV=development
