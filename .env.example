# Port the API/server listens on
PORT=5174

# MongoDB Atlas connection string. Point this at a free M0 cluster — use a separate
# database for local dev vs. production (e.g. "grocery_dev" vs "grocery_prod" as the path
# segment in the URI), so day-to-day dev work never touches real data.
#
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/grocery_dev
MONGODB_URI=

# Set to "production" to serve the built client from dist/client and mark session
# cookies secure (HTTPS-only).
NODE_ENV=development
